


string input = Console.ReadLine();

bool length = CharacterLength(input);
bool letterAndD = LetterAndDigit(input);
bool twoDigits = twoDigitsCheck(input);
bool result = true;


if (!length)
{
    Console.WriteLine("Password must be between 6 and 10 characters");
    result = false;
}
if (!letterAndD)
{
    Console.WriteLine("Password must consist only of letters and digits");
    result = false;
}
if (!twoDigits)
{
    Console.WriteLine("Password must have at least 2 digits");
    result = false;
}


if (result)
{
    Console.WriteLine("Password is valid");
}


static bool twoDigitsCheck(string input)
{
    //It should contain at least 2 digits
    int count = 0;

    foreach (char item in input)
    {
        if (Char.IsDigit(item))
        {
            count++;
        }
    }
    return count >= 2;
}

static bool LetterAndDigit(string input)
{
    //It should contain only letters and digits
    return input.All(Char.IsLetterOrDigit);
}

static bool CharacterLength(string input)
{
    //It should contain 6 – 10 characters (inclusive)
    return input.Length >= 6 && input.Length <= 10;
}

